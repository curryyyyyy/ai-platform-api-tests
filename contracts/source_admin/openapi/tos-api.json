{
  "openapi": "3.0.0",
  "info": {
    "title": "TOS URL Signing API",
    "version": "1.0.0",
    "description": "Batch generation of CDN and preview URLs for TOS paths"
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Local development" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "SignURLsRequest": {
        "type": "object",
        "required": ["tos_paths"],
        "properties": {
          "tos_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string" }
          },
          "include_cdn": { "type": "boolean", "default": true },
          "include_preview": { "type": "boolean", "default": true },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 60,
            "description": "Expiry in seconds; must not exceed the configured URL expiry"
          }
        }
      },
      "SignURLsResponse": {
        "type": "object",
        "required": ["code", "msg", "data"],
        "properties": {
          "code": { "type": "integer" },
          "msg": { "type": "string" },
          "data": {
            "type": "object",
            "required": ["total", "success", "partial", "failed", "items"],
            "properties": {
              "total": { "type": "integer" },
              "success": { "type": "integer" },
              "partial": { "type": "integer" },
              "failed": { "type": "integer" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["index", "tos_path", "status", "errors"],
                  "properties": {
                    "index": { "type": "integer" },
                    "tos_path": { "type": "string" },
                    "tos_cdn_url": { "type": "string", "nullable": true },
                    "tos_preview_url": { "type": "string", "nullable": true },
                    "expires_at": { "type": "string" },
                    "status": { "type": "string", "enum": ["ok", "partial", "failed"] },
                    "errors": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/api/v1/tos/sign-urls": {
      "post": {
        "summary": "Generate TOS CDN and preview signed URLs",
        "operationId": "signTosURLs",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignURLsRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Per-item signing result",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SignURLsResponse" } }
            }
          },
          "400": { "description": "Invalid request or expiry configuration" }
        }
      }
    }
  }
}
